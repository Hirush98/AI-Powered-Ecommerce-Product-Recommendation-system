{
  "name": "ai-recommendation-system",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node init && concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "node init && npm run dev --workspace=backend",
    "dev:frontend": "node init && npm run dev --workspace=frontend",
    "build": "node init && npm run build --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
